<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="applicationfront.end.yaf.view.FXMLControllerMainWindow">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu text="My Account">
            <items>
              <MenuItem fx:id="miChangePassword" onAction="#handleChangePassword" text="Change Password..." />
              <MenuItem fx:id="miSignOut" onAction="#handleSignOut" text="Sign Out" />
              <MenuItem fx:id="miExit" onAction="#handleExitAction" text="Exit" />
            </items>
          </Menu>
          <Menu text="Help">
            <items>
              <MenuItem text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblWelcome" text="Welcome to the Application">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label text="You have successfully signed in." textFill="#666666">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </center>
</BorderPane>